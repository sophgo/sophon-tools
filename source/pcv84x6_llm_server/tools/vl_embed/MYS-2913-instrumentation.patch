+// --- MYS-2913 diagnostics -------------------------------------------------
+// Read a row of a device buffer back and summarise it. A stage that is
+// supposed to produce activations but reports norm 0 is the first zero of the
+// chain; everything downstream of it is a consequence, not a cause.
+struct RowSummary {
+  double norm = 0;
+  int nonzero = 0;
+  unsigned long long hash = 1469598103934665603ULL;
+  float first[4] = {0, 0, 0, 0};
+};
+RowSummary summarise(bm_handle_t handle, bm_device_mem_t mem, size_t offset_bytes,
+                     int dims) {
+  RowSummary s;
+  std::vector<uint16_t> raw(static_cast<size_t>(dims));
+  bm_device_mem_t view = bm_mem_from_device(
+      mem.u.device.device_addr + offset_bytes, raw.size() * sizeof(uint16_t));
+  if (bm_memcpy_d2s(handle, raw.data(), view) != BM_SUCCESS) return s;
+  for (int i = 0; i < dims; ++i) {
+    const float v = aux::bf16_to_f32(raw[i]);
+    s.norm += static_cast<double>(v) * v;
+    if (v != 0.0f) ++s.nonzero;
+    if (i < 4) s.first[i] = v;
+    s.hash ^= raw[i];
+    s.hash *= 1099511628211ULL;
+  }
+  s.norm = std::sqrt(s.norm);
+  return s;
+}
